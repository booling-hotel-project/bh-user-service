<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="ru.booking.hotel.domain.user">

    <class name="GuestProfile" table="guest_profiles">
        <id name="userId" column="user_id" type="java.util.UUID">
            <generator class="assigned"/>
        </id>

        <property name="passport"     column="passport" type="java.lang.String"/>
        <property name="loyaltyLevel" column="loyalty_level" type="java.lang.String"/>
        <property name="preferences"  column="preferences" type="io.hypersistence.utils.hibernate.type.json.JsonNodeBinaryType"/>
    </class>

</hibernate-mapping>