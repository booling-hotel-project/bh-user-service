{
  "openapi": "3.0.3",
  "info": {
    "title": "User API Commands",
    "version": "1.0.0",
    "description": "Команды для API пользователей",
    "contact": {
      "email": "dsafoev40@gmail.com"
    }
  },
  "paths": {
  },
  "components": {
    "schemas": {
      "LoginUserRequest": {
        "type": "object",
        "description": "Команда авторизации пользователя: email или телефон + пароль",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email пользователя (указать email или phone)"
          },
          "phone": {
            "type": "string",
            "description": "Телефон пользователя (указать email или phone)"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "Пароль пользователя",
            "minLength": 8
          }
        },
        "required": [
          "password"
        ]
      },
      "RegisterUserRequest": {
        "type": "object",
        "description": "Команда регистрации пользователя: email + телефон + пароль",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email пользователя"
          },
          "phone": {
            "type": "string",
            "description": "Телефон пользователя"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "Пароль пользователя, минимум 8 символов",
            "minLength": 8
          }
        },
        "required": [
          "password","email","phone"
        ]
      },
      "RefreshTokenRequest": {
        "type": "object",
        "description": "Запрос обновления пары токенов",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "Действующий refresh-токен"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "CreateStaffRequest": {
        "type": "object",
        "description": "Создание сотрудника: аккаунт + профиль + роль персонала",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "description": "Email сотрудника"
          },
          "phone": {
            "type": "string",
            "description": "Телефон сотрудника"
          },
          "password": {
            "type": "string",
            "format": "password",
            "description": "Пароль, минимум 8 символов",
            "minLength": 8
          },
          "name": {
            "type": "string",
            "description": "ФИО сотрудника"
          },
          "role": {
            "type": "string",
            "description": "Роль персонала: MANAGER, HOUSEKEEPING, MAINTENANCE или ADMIN",
            "enum": [
              "MANAGER",
              "HOUSEKEEPING",
              "MAINTENANCE",
              "ADMIN"
            ]
          },
          "department": {
            "type": "string",
            "description": "Отдел"
          },
          "position": {
            "type": "string",
            "description": "Должность"
          }
        },
        "required": [
          "password",
          "email",
          "role"
        ]
      }
    }
  }
}