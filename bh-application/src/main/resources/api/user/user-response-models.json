{
  "openapi": "3.0.3",
  "info": {
    "title": "User API Response Models",
    "version": "1.0.0",
    "description": "Модели ответов API пользователей",
    "contact": {
      "email": "dsafoev40@gmail.com"
    }
  },
  "paths": {
  },
  "components": {
    "schemas": {
      "LoginUserResponse": {
        "type": "object",
        "description": "Результат успешной авторизации",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "Идентификатор пользователя"
          },
          "accessToken": {
            "type": "string",
            "description": "Токен доступа"
          },
          "refreshToken": {
            "type": "string",
            "description": "Токен обновления"
          },
          "tokenType": {
            "type": "string",
            "description": "Тип токена",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64",
            "description": "Время жизни токена доступа в секундах"
          }
        },
        "required": [
          "userId",
          "accessToken",
          "refreshToken"
        ]
      },
      "RegisterUserResponse": {
        "type": "object",
        "description": "Результат успешной регистрации",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "Идентификатор пользователя"
          },
          "accessToken": {
            "type": "string",
            "description": "Токен доступа"
          },
          "refreshToken": {
            "type": "string",
            "description": "Токен обновления"
          },
          "tokenType": {
            "type": "string",
            "description": "Тип токена",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64",
            "description": "Время жизни токена доступа в секундах"
          }
        },
        "required": [
          "userId",
          "accessToken",
          "refreshToken"
        ]
      },
      "CreateStaffResponse": {
        "type": "object",
        "description": "Результат создания сотрудника",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "Идентификатор созданного сотрудника"
          }
        },
        "required": [
          "userId"
        ]
      },
      "RefreshTokenResponse": {
        "type": "object",
        "description": "Новая пара токенов после обновления",
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "Идентификатор пользователя"
          },
          "accessToken": {
            "type": "string",
            "description": "Новый токен доступа"
          },
          "refreshToken": {
            "type": "string",
            "description": "Новый токен обновления"
          },
          "tokenType": {
            "type": "string",
            "description": "Тип токена",
            "example": "Bearer"
          },
          "expiresIn": {
            "type": "integer",
            "format": "int64",
            "description": "Время жизни токена доступа в секундах"
          }
        },
        "required": [
          "userId",
          "accessToken",
          "refreshToken"
        ]
      }
    }
  }
}
