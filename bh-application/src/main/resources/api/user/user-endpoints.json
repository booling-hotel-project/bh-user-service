{
  "openapi": "3.0.3",
  "info": {
    "title": "User API",
    "version": "1.0.0",
    "description": "User API реализует бизнес функции необходимые для управления пользователями, профилями, ролями и т.д.",
    "contact": {
      "email": "dsafoev40@gmail.com"
    }
  },
  "tags": [
    {
      "name": "User",
      "description": "Операции с пользователями"
    }
  ],
  "paths": {
    "/v1/user/auth/login": {
      "post": {
        "tags": [
          "User"
        ],
        "summary": "Авторизация существующего пользователя",
        "description": "Команда служит для авторизации пользователя в системе бронирования отелей",
        "operationId": "loginUser",
        "requestBody": {
          "description": "Атрибуты при авторизации пользователя",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "user-request-models.json#/components/schemas/LoginUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успешная авторизация",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "user-response-models.json#/components/schemas/LoginUserResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "../common/common-contract.json#/components/responses/ValidationErrorResponse"
          },
          "401": {
            "$ref": "../common/common-contract.json#/components/responses/UnauthorizedErrorResponse"
          },
          "404": {
            "$ref": "../common/common-contract.json#/components/responses/NotFoundErrorResponse"
          }
        }
      }
    },
    "/v1/user/auth/register": {
      "post": {
        "tags": [
          "User"
        ],
        "summary": "Регистрация нового пользователя",
        "description": "Команда служит для регистрации пользователя в системе бронирования отелей",
        "operationId": "registerUser",
        "requestBody": {
          "description": "Атрибуты при регистрации пользователя",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "user-request-models.json#/components/schemas/RegisterUserRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Успешная регистрация",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "user-response-models.json#/components/schemas/RegisterUserResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "../common/common-contract.json#/components/responses/ValidationErrorResponse"
          },
          "404": {
            "$ref": "../common/common-contract.json#/components/responses/NotFoundErrorResponse"
          },
          "409": {
            "$ref": "../common/common-contract.json#/components/responses/ConflictErrorResponse"
          }
        }
      }
    },
    "/v1/user/staff": {
      "post": {
        "tags": [
          "User"
        ],
        "summary": "Создание сотрудника",
        "description": "Создает аккаунт сотрудника с профилем и ролью персонала. Токены не выдаются, вход через login",
        "operationId": "createStaff",
        "requestBody": {
          "description": "Данные сотрудника и его роль",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "user-request-models.json#/components/schemas/CreateStaffRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Сотрудник создан",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "user-response-models.json#/components/schemas/CreateStaffResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "../common/common-contract.json#/components/responses/ValidationErrorResponse"
          },
          "404": {
            "$ref": "../common/common-contract.json#/components/responses/NotFoundErrorResponse"
          },
          "409": {
            "$ref": "../common/common-contract.json#/components/responses/ConflictErrorResponse"
          }
        }
      }
    },
    "/v1/user/auth/refresh": {
      "post": {
        "tags": [
          "User"
        ],
        "summary": "Обновление пары токенов по refresh-токену",
        "description": "Команда служит для обновления токенов доступа: старый refresh-токен инвалидируется, выдается новая пара",
        "operationId": "refreshToken",
        "requestBody": {
          "description": "Refresh-токен для обновления",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "user-request-models.json#/components/schemas/RefreshTokenRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Токены успешно обновлены",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "user-response-models.json#/components/schemas/RefreshTokenResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "../common/common-contract.json#/components/responses/ValidationErrorResponse"
          },
          "401": {
            "$ref": "../common/common-contract.json#/components/responses/UnauthorizedErrorResponse"
          }
        }
      }
    }
  }
}
