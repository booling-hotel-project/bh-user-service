<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="ru.booking.hotel.domain.token">

    <class name="ru.booking.hotel.domain.token.RefreshToken" table="refresh_tokens">
        <id name="id" column="id" type="java.util.UUID">
            <generator class="org.hibernate.id.UUIDGenerator"/>
        </id>

        <property name="userId"    column="user_id"    not-null="true" type="java.util.UUID"/>
        <property name="tokenHash" column="token_hash" not-null="true"/>
        <property name="tokenType" column="token_type" not-null="true">
            <type name="org.hibernate.type.EnumType">
                <param name="enumClass">ru.booking.hotel.domain.token.TokenType</param>
                <param name="useNamed">true</param>
            </type>
        </property>
        <property name="expiresAt" column="expires_at" not-null="true"
                  type="java.time.OffsetDateTime"/>
    </class>

</hibernate-mapping>