<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="ru.booking.hotel.domain.role">

    <class name="ru.booking.hotel.domain.role.UserRole" table="user_roles">
        <id name="id" column="id" type="java.util.UUID">
            <generator class="org.hibernate.id.UUIDGenerator"/>
        </id>

        <property name="userId" column="user_id" not-null="true" type="java.util.UUID"/>
        <property name="roleId" column="role_id" not-null="true" type="java.util.UUID"/>
    </class>

</hibernate-mapping>